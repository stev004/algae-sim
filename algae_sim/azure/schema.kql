// algae-sim pipeline schema for Azure Data Explorer.
// Generated by `python -m algae_sim.azure schema`; don't edit by hand.
// Run each command in the Data Explorer web UI (select it, then Run).

.alter database ['algae'] policy streamingingestion enable

.create-merge table Environment (device_id: string, sequence: long, timestamp: datetime, command_id: string, experiment_id: string, hold_number: int, hold_elapsed_h: real, temperature_c: real, setpoint_c: real, light_umol_m2_s: real, heater_command: real, heater_applied: real, tripped: bool, safe_state: bool, energy_kwh: real, faults: dynamic, ph: real, ph_setpoint: real, co2_valve_open: bool, co2_g: real, batch_id: string, ingested_at: datetime)

.create-or-alter table Environment ingestion json mapping 'EnvironmentMapping'
'[{"column":"device_id","path":"$.device_id"},{"column":"sequence","path":"$.sequence"},{"column":"timestamp","path":"$.timestamp"},{"column":"command_id","path":"$.command_id"},{"column":"experiment_id","path":"$.experiment_id"},{"column":"hold_number","path":"$.hold_number"},{"column":"hold_elapsed_h","path":"$.hold_elapsed_h"},{"column":"temperature_c","path":"$.temperature_c"},{"column":"setpoint_c","path":"$.setpoint_c"},{"column":"light_umol_m2_s","path":"$.light_umol_m2_s"},{"column":"heater_command","path":"$.heater_command"},{"column":"heater_applied","path":"$.heater_applied"},{"column":"tripped","path":"$.tripped"},{"column":"safe_state","path":"$.safe_state"},{"column":"energy_kwh","path":"$.energy_kwh"},{"column":"faults","path":"$.faults"},{"column":"ph","path":"$.ph"},{"column":"ph_setpoint","path":"$.ph_setpoint"},{"column":"co2_valve_open","path":"$.co2_valve_open"},{"column":"co2_g","path":"$.co2_g"},{"column":"batch_id","path":"$.batch_id"},{"column":"ingested_at","path":"$.ingested_at"}]'

.create-merge table Od (device_id: string, sequence: long, timestamp: datetime, command_id: string, experiment_id: string, hold_number: int, hold_elapsed_h: real, od750: real, saturated: bool, batch_id: string, ingested_at: datetime)

.create-or-alter table Od ingestion json mapping 'OdMapping'
'[{"column":"device_id","path":"$.device_id"},{"column":"sequence","path":"$.sequence"},{"column":"timestamp","path":"$.timestamp"},{"column":"command_id","path":"$.command_id"},{"column":"experiment_id","path":"$.experiment_id"},{"column":"hold_number","path":"$.hold_number"},{"column":"hold_elapsed_h","path":"$.hold_elapsed_h"},{"column":"od750","path":"$.od750"},{"column":"saturated","path":"$.saturated"},{"column":"batch_id","path":"$.batch_id"},{"column":"ingested_at","path":"$.ingested_at"}]'

.create-merge table Rejected (line: int, reason: string, detail: string, text: string, batch_id: string, ingested_at: datetime)

.create-or-alter table Rejected ingestion json mapping 'RejectedMapping'
'[{"column":"line","path":"$.line"},{"column":"reason","path":"$.reason"},{"column":"detail","path":"$.detail"},{"column":"text","path":"$.text"},{"column":"batch_id","path":"$.batch_id"},{"column":"ingested_at","path":"$.ingested_at"}]'

.create-merge table Batches (blob_name: string, lines: int, rows: int, rejected: int, batch_id: string, ingested_at: datetime)

.create-or-alter table Batches ingestion json mapping 'BatchesMapping'
'[{"column":"blob_name","path":"$.blob_name"},{"column":"lines","path":"$.lines"},{"column":"rows","path":"$.rows"},{"column":"rejected","path":"$.rejected"},{"column":"batch_id","path":"$.batch_id"},{"column":"ingested_at","path":"$.ingested_at"}]'

// One row per message: resends and replays land twice in the raw tables,
// and these views keep the latest copy of each (device_id, sequence).
.create-or-alter materialized-view with (backfill=true) EnvironmentClean on table Environment
{
    Environment | summarize arg_max(ingested_at, *) by device_id, sequence
}

.create-or-alter materialized-view with (backfill=true) OdClean on table Od
{
    Od | summarize arg_max(ingested_at, *) by device_id, sequence
}

// Per hold (one reactor's culture under one command), from stored data only.
.create-or-alter function
with (folder="report", docstring="Per-hold summary, as the local pipeline report")
HoldSummary() {
    let warmup_h = 3.0;
    let env = EnvironmentClean | where safe_state == false;
    let od = OdClean
        | summarize (first_h, od_start) = arg_min(hold_elapsed_h, od750),
                    (last_h, od_end) = arg_max(hold_elapsed_h, od750),
                    od_readings = count()
          by device_id, command_id;
    env
    | summarize hold_number = take_any(hold_number),
                setpoint_c = take_any(setpoint_c),
                light_umol_m2_s = take_any(light_umol_m2_s),
                ph_setpoint = take_any(ph_setpoint),
                samples = count(),
                mean_abs_deviation_c = avgif(
                    abs(temperature_c - setpoint_c),
                    hold_elapsed_h >= warmup_h and isnotnull(temperature_c)),
                mean_abs_ph_deviation = avgif(abs(ph - ph_setpoint),
                                              hold_elapsed_h >= warmup_h and isnotnull(ph)),
                missing_temperature = countif(isnull(temperature_c)),
                missing_ph = countif(isnull(ph)),
                protection_tripped = max(toint(tripped)) == 1,
                energy_kwh = max(energy_kwh),
                co2_g = max(co2_g)
      by device_id, command_id
    | join kind=leftouter od on device_id, command_id
    | extend growth_rate_per_h = iff(od_start > 0 and od_end > 0 and last_h > first_h,
                                     log(od_end / od_start) / (last_h - first_h), real(null))
    | project-away device_id1, command_id1, first_h, last_h
    | order by hold_number asc, device_id asc
}

// Batches, lines, rejections, and how many duplicates the views removed.
.create-or-alter function with (folder="report", docstring="Pipeline health counters")
PipelineHealth() {
    let stored = toscalar(Environment | count) + toscalar(Od | count);
    let unique = toscalar(EnvironmentClean | count) + toscalar(OdClean | count);
    Batches
    | summarize batches = dcount(batch_id), lines = sum(lines), rejected = sum(rejected)
    | extend rows_stored = stored, unique_messages = unique, duplicates_removed = stored - unique
}
